# Copy to .env and fill in your values

# Firebase project config (from Firebase Console → Project Settings → Your apps)
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Google OAuth client IDs (from Google Cloud Console → Credentials)
# Web client ID is required for Expo Go / expo-auth-session
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# iOS and Android client IDs are needed for standalone builds
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=

# Backend API base URL
EXPO_PUBLIC_API_URL=https://api.hirelith.com
